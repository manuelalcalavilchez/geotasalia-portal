# -------------------------------------------------------
# GeoTasalia Portal — Variables de Entorno
# Copia este archivo como .env y rellena los valores
# -------------------------------------------------------

# Puerto del servidor (por defecto 3000)
PORT=3000

# Directorio de datos persistentes (por defecto ./data)
# En Docker apunta al volumen montado: /app/data
DATA_DIR=./data

# ---- SMTP (correo saliente) ----
SMTP_HOST=mail.infomaniak.com
SMTP_PORT=587
SMTP_USER=gestion@geotasalia.es
SMTP_PASS=tu_contraseña_smtp_aqui
SMTP_TO=jorge.martinez@geotasalia.es
SMTP_BCC=copia_oculta@ejemplo.com

# ---- Opcionales ----
# URL pública de la aplicación (para enlaces en emails)
APP_URL=https://tu-dominio.com
